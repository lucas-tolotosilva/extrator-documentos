# Copie este arquivo para .env e preencha para usar extração via IA real.
# Sem nenhuma das duas, o backend roda automaticamente em modo demonstração
# (extração heurística local, sem custo).

# Gratuito — console.groq.com/keys (tem prioridade sobre ANTHROPIC_API_KEY)
GROQ_API_KEY=

# Opcional, requer créditos pagos — console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
